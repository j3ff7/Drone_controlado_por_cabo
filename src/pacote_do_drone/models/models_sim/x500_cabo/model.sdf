<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_cabo'>
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <include merge='true'>
      <uri>model://cabo</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <joint name="drone_cabo_joint" type="ball">
      <parent>base_link</parent>
      <child>raiz_cabo</child>
    </joint>

    <include>
      <uri>model://rover_mecanum</uri>
      <name>rover</name>
      <pose>2.5 0 0 0 0 0</pose>
    </include>

    <joint name="ponta_rover_joint" type="fixed">
      <parent>ponta_cabo</parent>
      <child>rover::base_link</child>
      <pose>0 0 0.07 0 0 0</pose>
    </joint>
  </model>
</sdf>