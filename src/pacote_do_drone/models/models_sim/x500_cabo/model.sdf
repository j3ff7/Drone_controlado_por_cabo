<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_cabo'>
    <include merge='true'>
      <uri>model://x500_base</uri>
    </include>

    <include merge='true'>
      <uri>model://cabo</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <joint name="drone_cabo_joint" type="ball">
      <parent>base_link</parent>
      <child>raiz_cabo</child>
    </joint>
  </model>
</sdf>