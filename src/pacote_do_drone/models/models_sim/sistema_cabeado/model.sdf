<?xml version="1.0"?>
<sdf version="1.10">
  <model name="x500_cabo">
    <static>false</static>

    <!-- Drone -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Cabo -->
    <include merge="true">
      <uri>model://cabo</uri>
      <pose>0 0 0.24 0 0 0</pose>
    </include>

    <!-- Conexão entre o drone e o cabo -->
    <joint name="drone_cabo_joint" type="ball">
      <parent>base_link</parent>
      <child>raiz_cabo</child>
    </joint>

    <plugin
      filename="gz-sim-forcetorque-system"
      name="gz::sim::systems::ForceTorque"/>
  </model>
</sdf>