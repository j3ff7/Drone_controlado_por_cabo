<?xml version="1.0"?>
<sdf version="1.10">
  <world name="default">

    <!-- Conjunto drone + cabo -->
    <include>
      <uri>model://x500_cabo</uri>
      <name>x500_cabo</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Rover independente -->
    <include>
      <uri>model://rover_mecanum</uri>
      <name>rover_mecanum_1</name>
      <pose>1.7 0 0 0 0 0</pose>
    </include>

    <!-- Conexão entre a ponta do cabo e o rover -->
    <joint name="cabo_rover_joint" type="universal">
      <pose relative_to="rover_mecanum_1::base_link">
        0 0 0.15 0 0 0
      </pose>

      <parent>x500_cabo::ponta_cabo</parent>
      <child>rover_mecanum_1::base_link</child>

      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
        <dynamics>
          <damping>0.002</damping>
          <friction>0</friction>
        </dynamics>
      </axis>

      <axis2>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
        </limit>
        <dynamics>
          <damping>0.002</damping>
          <friction>0</friction>
        </dynamics>
      </axis2>
    </joint>

  </world>
</sdf>