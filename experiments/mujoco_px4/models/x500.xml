<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal X500 derived from px4/PX4-Autopilot/Tools/simulation/gz/models/x500/model.sdf. -->
<mujoco model="px4_x500">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.001" gravity="0 0 -9.80665" integrator="RK4" density="1.2" viscosity="0"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="1.0 0.05 0.05"/>
    <site type="sphere" size="0.008" rgba="1 0 0 1"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.28 0.30"
             rgb2="0.32 0.35 0.38" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <!-- MuJoCo world ENU; vehicle body FLU. -->
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="60 60 0.1" material="grid" pos="0 0 0"/>
    <site name="east_marker" pos="3 0 0.02" size="0.05" rgba="1 0.2 0.2 1"/>
    <site name="north_marker" pos="0 3 0.02" size="0.05" rgba="0.2 1 0.2 1"/>

    <body name="base_link" pos="0 0 0.24">
      <freejoint name="base_free"/>
      <!-- Aggregate of the SDF base (2 kg) and four 16.0769 g rotor links. -->
      <inertial pos="0 0 0.00186913" mass="2.0643076923076924"
                diaginertia="0.02383948 0.02394241 0.04399995"/>

      <geom name="core" type="box" size="0.1767767 0.1767767 0.025"
            pos="0 0 0.007" density="0" rgba="0.12 0.14 0.18 1"/>
      <geom name="nose" type="box" size="0.045 0.012 0.006" pos="0.11 0 0.04"
            density="0" contype="0" conaffinity="0" rgba="0.9 0.35 0.1 1"/>

      <geom name="arm0" type="capsule" fromto="0 0 0.03 0.174 -0.174 0.06"
            size="0.008" density="0" rgba="0.35 0.35 0.4 1"/>
      <geom name="arm1" type="capsule" fromto="0 0 0.03 -0.174 0.174 0.06"
            size="0.008" density="0" rgba="0.35 0.35 0.4 1"/>
      <geom name="arm2" type="capsule" fromto="0 0 0.03 0.174 0.174 0.06"
            size="0.008" density="0" rgba="0.35 0.35 0.4 1"/>
      <geom name="arm3" type="capsule" fromto="0 0 0.03 -0.174 -0.174 0.06"
            size="0.008" density="0" rgba="0.35 0.35 0.4 1"/>

      <geom name="leg0" type="capsule" fromto="0.09 -0.09 -0.02 0.11 -0.11 -0.22"
            size="0.0075" density="0" rgba="0.25 0.25 0.28 1"/>
      <geom name="leg1" type="capsule" fromto="-0.09 0.09 -0.02 -0.11 0.11 -0.22"
            size="0.0075" density="0" rgba="0.25 0.25 0.28 1"/>
      <geom name="foot0" type="capsule" fromto="-0.125 -0.11 -0.22 0.125 -0.11 -0.22"
            size="0.0075" density="0" rgba="0.25 0.25 0.28 1"/>
      <geom name="foot1" type="capsule" fromto="-0.125 0.11 -0.22 0.125 0.11 -0.22"
            size="0.0075" density="0" rgba="0.25 0.25 0.28 1"/>

      <site name="imu" pos="0 0 0" quat="1 0 0 0"/>
      <!-- PX4 order: front-right CCW, rear-left CCW, front-left CW, rear-right CW. -->
      <site name="rotor0" pos="0.174 -0.174 0.06" rgba="0.9 0.3 0.3 1"/>
      <site name="rotor1" pos="-0.174 0.174 0.06" rgba="0.3 0.3 0.9 1"/>
      <site name="rotor2" pos="0.174 0.174 0.06" rgba="0.9 0.3 0.3 1"/>
      <site name="rotor3" pos="-0.174 -0.174 0.06" rgba="0.3 0.3 0.9 1"/>
    </body>
  </worldbody>

  <sensor>
    <accelerometer name="imu_accel" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
  </sensor>
</mujoco>
